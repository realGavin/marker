# Copy to .env (gitignored). SERVER-SIDE ONLY — this key bypasses RLS.
# From Supabase Dashboard -> Project Settings -> API keys -> "secret" key
# (starts with sb_secret_). NEVER put this key in the mobile app or in chat.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR-KEY
