# Copy to .env and fill in from your Supabase project dashboard:
# Project Settings -> API. These are PUBLISHABLE values (protection is RLS),
# but .env stays gitignored anyway. Never put service-role keys here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Production tile endpoint (Cloudflare worker over R2):
# EXPO_PUBLIC_TILE_URL=https://marker-tiles.shuozeng21.workers.dev/basemap-us/{z}/{x}/{y}.mvt
# Dev alternative (pmtiles serve on this Mac):
# EXPO_PUBLIC_TILE_URL=http://127.0.0.1:8082/basemap-us/{z}/{x}/{y}.mvt
