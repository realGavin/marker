# Copy to .env and fill in from your Supabase project dashboard:
# Project Settings -> API. These are PUBLISHABLE values (protection is RLS),
# but .env stays gitignored anyway. Never put service-role keys here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
